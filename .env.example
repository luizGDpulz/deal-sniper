# ==============================================================================
# Deal Sniper — Environment Configuration
# ==============================================================================
# Copy to .env and fill with your credentials. NEVER commit .env to Git.

# --- Telegram Bot API (@BotFather) ---
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# --- Security Allowlist (REQUIRED) ---
# Comma-separated Telegram User IDs allowed to run bot commands (find via @userinfobot)
ALLOWED_USER_IDS=123456789
# Optional: restrict commands & alerts to a single private group/supergroup ID (e.g. -1001234567890)
ALLOWED_CHAT_ID=

# --- Telegram MTProto Userbot (https://my.telegram.org) ---
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Generated once via `pnpm run auth` (or `docker compose run --rm deal-sniper node dist/scripts/auth-session.js`)
TELEGRAM_SESSION=

# --- Sync & Pipeline ---
# Optional Telegram Chat Folder name containing your promo channels (e.g. Promos). Leave empty to sync all channels/megagroups.
TELEGRAM_FOLDER_NAME=Promos
SYNC_INTERVAL_MINUTES=30
DEDUPE_TTL_HOURS=12

# --- SSRF Unshortener Safeguards ---
UNSHORTEN_URLS=true
MAX_REDIRECTS=8
HTTP_TIMEOUT_MS=5000

# --- Storage & Logging ---
DATABASE_PATH=/app/data/deal-sniper.db
LOG_LEVEL=info
TZ=America/Sao_Paulo
