{
  "name": "deal-sniper",
  "version": "0.1.0",
  "description": "Automated Telegram deal radar & price-budget sniper with event-driven MTProto ingestion, SSRF-safe unshortening, and SQLite price tracking.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "auth": "tsx src/scripts/auth-session.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "telegram",
    "bot",
    "grammy",
    "gramjs",
    "mtproto",
    "price-tracker",
    "deals",
    "sqlite",
    "typescript"
  ],
  "author": "Luiz Gustavo Dias Pulz <luizgustavodiaspulzoficial@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizGDpulz/deal-sniper.git"
  },
  "bugs": {
    "url": "https://github.com/luizGDpulz/deal-sniper/issues"
  },
  "homepage": "https://github.com/luizGDpulz/deal-sniper#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "grammy": "^1.35.0",
    "telegram": "^2.26.22",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
